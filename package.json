{
  "name": "altitude-metrix-wallet",
  "version": "3.4.2",
  "description": "The Altitude wallet",
  "homepage": "https://github.com/thelindaprojectinc/altitude",
  "author": {
    "name": "Metrix"
  },
  "keywords": [
    "wallet",
    "metrix",
    "altitude"
  ],
  "main": "main.js",
  "private": true,
  "scripts": {
    "postinstall": "npm run postinstall:electron",
    "postinstall:web": "node postinstall-web",
    "postinstall:electron": "node postinstall",
    "ng": "ng",
    "start": "npm run postinstall:electron && npm-run-all -p ng:serve electron:serve",
    "build": "npm run postinstall:electron && npm run electron:serve-tsc && ng build",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "ng:serve": "ng serve",
    "ng:serve:web": "npm run postinstall:web && ng serve -o",
    "electron:serve-tsc": "tsc -p tsconfig-serve.json",
    "electron:serve": "wait-on http-get://localhost:4200/ && npm run electron:serve-tsc && electron . --serve",
    "electron:local": "npm run build:prod && electron .",
    "electron:linux": "npm run build:prod && electron-builder build --linux",
    "electron:linux-snap": "npm run build:prod && electron-builder --linux snap",
    "electron:windows": "npm run build:prod && electron-builder build --windows",
    "electron:windows32": "npm run build:prod && electron-builder build --windows --ia32",
    "electron:mac": "npm run build:prod && electron-builder build --mac --arm64",
    "electron:mac-x64": "npm run build:prod && electron-builder build --mac --x64",
    "test": "npm run postinstall:web && ng test",
    "e2e": "npm run postinstall:web && ng e2e"
  },
  "dependencies": {
    "@angular/localize": "^21.2.19",
    "@electron/remote": "2.1.3",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-common-types": "7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@iharbeck/ngx-virtual-scroller": "^20.0.0",
    "@metrixcoin/metrilib": "^1.6.2-beta",
    "@metrixnames/mnslib": "^2.2.1",
    "@metrixnames/pricelib": "^1.0.5",
    "@tweenjs/tween.js": "^25.0.0",
    "angular-notifier2": "^9.2.1",
    "app-builder-lib": "26.15.3",
    "assert": "^2.1.0",
    "axios": "1.19.0",
    "braces": "^3.0.3",
    "browser-request": "^0.3.3",
    "browserify-fs": "^1.0.0",
    "browserify-zlib": "^0.2.0",
    "bs58": "^6.0.0",
    "chart.js": "^4.5.1",
    "compare-versions": "^6.1.1",
    "crypto": "^1.0.1",
    "crypto-browserify": "^3.12.1",
    "ejs": "^3.1.10",
    "electron-json-storage": "^4.6.0",
    "electron-log": "5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.1",
    "follow-redirects": "^1.16.0",
    "https-browserify": "^1.0.0",
    "net-browserify": "^0.2.4",
    "ngx-smart-modal": "^14.1.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.26",
    "public-ip": "^4.0.2",
    "qs": "6.15.3",
    "querystring-es3": "^0.2.1",
    "request": "^2.88.2",
    "rxjs": "^7.8.1",
    "rxjs-compat": "^6.6.7",
    "socket.io": "^4.8.3",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "tar": "^7.5.22",
    "timers-browserify": "^2.0.12",
    "tls-browserify": "^0.2.2",
    "tslib": "^2.8.1",
    "uint256": "^1.0.8",
    "unzipper": "^0.12.5",
    "url": "^0.11.4",
    "url-metadata": "^5.10.0",
    "util": "^0.12.5",
    "webpack-dev-middleware": "^8.1.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/language-service": "21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^24.13.3",
    "codelyzer": "^6.0.0",
    "core-js": "3.50.0",
